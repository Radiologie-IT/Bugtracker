<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!--
	TARGET: Targets where bugtracks will be sent
	IMPORTANT: MUST be configured before problem categories for category specific targets to work
	-->

	<targets>
		<target type="webupload" name="Web Backend Upload" serverurl="http://your-bugtracker-server" default="true">
		</target>

		<target type="folder" name="Network Share Folder" path='\\your-server\bugtracker-share\' foldername="Bugtracker-%idString%-%date%-%time%" default="false" obligatory="false">
		</target>

		<target type="mail" name="Support Mail" default="false"
				recipient="support@your-domain.com"
				sender="bugtracker@your-domain.com" smtpserver="smtp.your-domain.com" smtpport="587" smtpssl="True" smtpuser="" smtppass=""
				subject="Bugtracker: %clientname%.%domainname% (%date%-%time%)" htmltemplate="path_to_template.html" attachzip="true">
		</target>

		<target type="powershell" name="Custom PowerShell Script" default="false" obligatory="false"
				path="path_to_script.ps1"
				logoutput="true">
		</target>
	</targets>


	<!--
	PROBLEM DESCRIPTION: Descriptions for problem categories.
	-->

	<problem-categories>
		<problem-category name="General Error" ticket="general-error">
			<description text="The following error occurred:" />
			<app-selection>All</app-selection>
			<target name="Web Backend Upload" />
		</problem-category>

		<problem-category name="Application Crash" ticket="app-crash">
			<description text="The application crashed with the following details:" />
			<app-selection>Screen,PrimaryApp</app-selection>
			<target name="Network Share Folder" />
		</problem-category>

		<problem-category name="Missing Data" ticket="missing-data">
			<description text="The following data is missing or was not processed:" />
			<app-selection>Screen,PrimaryApp,SecondaryApp</app-selection>
			<target name="Network Share Folder" />
		</problem-category>

		<problem-category name="Performance Issue" ticket="perf-issue">
			<description text="The application is slow or unresponsive:" />
			<app-selection>PrimaryApp,ServiceApp,Screen</app-selection>
			<target name="Network Share Folder" />
		</problem-category>

		<problem-category name="Plugin Error" ticket="plugin-error">
			<description text="The following plugin error occurred:" />
			<app-selection>PrimaryApp,PluginApp,Screen</app-selection>
			<target name="Network Share Folder" />
		</problem-category>

		<problem-category name="Network Connectivity Issue" ticket="network-issue">
			<description text="Network connectivity problem detected:" />
			<app-selection>All</app-selection>
			<target name="Web Backend Upload" />
		</problem-category>

		<problem-category name="Other" ticket="other">
			<description text="Other issue description:" />
			<app-selection>All</app-selection>
			<target name="Network Share Folder" />
		</problem-category>
	</problem-categories>

	<!--
	APPLICATION SECTION
	-->
	<applications>
		<!--
		<application name="SQL" standard="false" show="false">
			<query name ="SQLString" queryString="select 1"/>
		</application>
		-->

		<!--
			Bugtracker
			-->
		<application name="Bugtracker" executable="C:\Bugtracker\" standard="true" show="always">
			<log location="client"
				path="C:\Bugtracker\"
				filename="*.log"
				find="NEW" />
			<!--
			<pre-fetch path="path_to_file"/>
			<post-fetch path="path_to_file">
			/ -->
		</application>


		<!--
		Primary Application - logs from local client paths only
		-->
		<application name="PrimaryApp" executable="C:\Program Files\YourCompany\PrimaryApp\"
			standard="true" show="installed">
			<log location="client"
				path="C:\Program Files\YourCompany\PrimaryApp\"
				filename="primaryapp_*.log"
				find="NEW" />
			<log location="client"
				path="%ProgramData%\YourCompany\PrimaryApp\Logs\"
				filename="*.log"
				find="NEW" />
		</application>

		<!--
		Secondary Application - logs from both client and a network server share
		-->
		<application name="SecondaryApp" executable="C:\Program Files\YourCompany\SecondaryApp\"
			standard="true" show="installed">
			<log location="client"
				path="%ProgramData%\YourCompany\SecondaryApp\Logs\"
				filename="secondaryapp_*.log"
				find="NEW" />
			<log location="server"
				path="\\your-server\logs\secondaryapp\"
				filename="*%clientname%*"
				find="NEW" />
		</application>

		<!--
		Service Application - server-side logs filtered by client name and username
		-->
		<application name="ServiceApp" executable="C:\Program Files\YourCompany\ServiceApp\"
			standard="true" show="installed">
			<log location="server"
				path="\\your-server\logs\service\"
				filename="service.*%clientname%*.log"
				find="NEW" />
			<log location="server"
				path="\\your-server\logs\service\"
				filename="service*%clientname%*%username%*.log"
				find="NEW" />
			<log location="client"
				path="%ProgramData%\YourCompany\ServiceApp\"
				filename="service_*.log"
				find="NEW" />
		</application>

		<!--
		Plugin Application - logs collected via terminal server client path and local AppData
		-->
		<application name="PluginApp" executable="C:\Program Files\YourCompany\PluginApp"
			standard="true" show="always">
			<log location="host"
				path="\\tsclient\c\Program Files\YourCompany\PluginApp\"
				filename="*.log"
				find="NEW" />
			<log location="host"
				path="\\tsclient\C\Users\%username%\AppData\Local\YourCompany\PluginApp\logs\"
				filename="*.log"
				find="NEW" />
			<log location="client"
				path="%LOCALAPPDATA%\YourCompany\PluginApp\logs\"
				filename="*.log"
				find="NEW" />
		</application>

		<!--
		Remote Tool - executable resides on a network share, server-only logs
		-->
		<application name="RemoteTool"
			executable="\\your-server\tools\remotetool\remotetool.exe" type="log"
			standard="false" show="always">
			<log location="server"
				path="\\your-server\logs\remotetool\"
				filename="remotetool_*%clientname%*.log"
				find="NEW" />
		</application>

		<!--
		Diagnostic Service - collects all logs and runs a post-fetch command for additional info
		-->
		<application name="DiagService" executable="C:\Program Files\YourCompany\DiagService"
			standard="false" show="installed">
			<log location="client"
				path="C:\Program Files\YourCompany\DiagService"
				filename="diagservice_*.log"
				find="ALL" />
			<post-fetch path="tree C:\DiagData /f >> C:\Bugtracker\blackhole\diagtree.log">
			</post-fetch>
		</application>

	</applications>

</configuration>
